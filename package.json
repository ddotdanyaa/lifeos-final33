{
  "name": "lifeos-v34-personal-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "smoke": "node smoke.mjs",
    "setup-whisper-cpp": "node tools/setup-whisper-cpp.mjs",
    "stamp": "node tools/stamp-version.mjs",
    "whisper-server": "vendorwhisper-cppReleasewhisper-server.exe --model vendorwhisper-cppggml-large-v3-turbo.bin --language ru --port 8090",
    "e2e": "playwright test output/playwright/human-public.spec.mjs output/playwright/final-human-product.spec.mjs --workers=1 --reporter=line",
    "e2e:owner": "playwright test output/playwright/owner-rescue.spec.mjs --reporter=line",
    "e2e:journeys": "playwright test output/playwright/final-journeys.spec.mjs --reporter=line",
    "e2e:final-owner": "playwright test output/playwright/final-owner-journeys.spec.mjs --reporter=line",
    "e2e:market-owner": "playwright test output/playwright/market-owner.spec.mjs --reporter=line",
    "e2e:calendar": "playwright test output/playwright/final-human-product.spec.mjs --grep \"H08\" --reporter=line",
    "e2e:finance": "playwright test output/playwright/final-human-product.spec.mjs --grep \"H03\" --reporter=line",
    "e2e:reader-player": "playwright test output/playwright/final-human-product.spec.mjs --grep \"H09\" --reporter=line",
    "e2e:graph": "playwright test output/playwright/final-human-product.spec.mjs --grep \"H07\" --reporter=line",
    "e2e:ai-providers": "playwright test output/playwright/final-journeys.spec.mjs --grep \"P19\" --reporter=line",
    "e2e:product-brain": "playwright test output/playwright/product-brain.spec.mjs --reporter=line",
    "e2e:human-public": "playwright test output/playwright/human-public.spec.mjs --reporter=line",
    "e2e:final-human-product": "playwright test output/playwright/final-human-product.spec.mjs --reporter=line",
    "e2e:quality": "playwright test output/playwright/owner-quality-audit.spec.mjs --reporter=line",
    "e2e:ux": "playwright test output/playwright/ux-rescue.spec.mjs --reporter=line",
    "e2e:fixtures": "node tools/audit-fixture-matrix.mjs",
    "e2e:visual": "playwright test output/playwright/owner-rescue.spec.mjs --grep @visual --reporter=line",
    "audit:no-hardcoded-sample": "node tools/audit-no-hardcoded-sample.mjs",
    "audit:buttons": "node tools/audit-buttons.mjs",
    "audit:ledger": "node tools/audit-ledger.mjs",
    "audit:market-ledger": "node tools/audit-market-ledger.mjs",
    "audit:visual-hierarchy": "node tools/audit-visual-hierarchy.mjs",
    "audit:no-cockpit-first-screen": "node tools/audit-no-cockpit-first-screen.mjs",
    "audit:workspace-distinctness": "node tools/audit-workspace-distinctness.mjs",
    "audit:semantic-colors": "node tools/audit-semantic-colors.mjs",
    "audit:journeys": "node tools/audit-final-journeys.mjs",
    "audit:human-ux-final": "node tools/audit-human-ux-final.mjs",
    "audit:performance-final": "node tools/audit-performance-final.mjs",
    "audit:recovery-final": "node tools/audit-recovery-final.mjs",
    "audit:nonstop-until-done": "node tools/audit-nonstop-until-done.mjs",
    "audit:architecture": "node tools/audit-architecture-contract.mjs",
    "audit:seven-contracts": "node tools/audit-seven-contracts.mjs",
    "audit:system-factory": "node tools/audit-system-factory.mjs",
    "audit:owner-final": "node tools/audit-owner-rescue-final.mjs",
    "audit:product-brain": "node tools/audit-product-brain.mjs",
    "audit:no-label-theater": "node tools/audit-no-label-theater.mjs",
    "audit:no-label-theater-hard": "node tools/audit-no-label-theater-hard.mjs",
    "audit:primary-ui-language": "node tools/audit-primary-ui-language.mjs",
    "audit:home-complexity": "node tools/audit-home-complexity.mjs",
    "audit:workspace-shape": "node tools/audit-workspace-shape.mjs",
    "audit:public-build": "node tools/audit-public-build.mjs",
    "audit:release-evidence": "node tools/audit-release-evidence.mjs",
    "audit:workspace-links": "node tools/audit-workspace-links.mjs",
    "release:push": "node tools/push-owner-rescue.mjs",
    "build:public": "node tools/build-public.mjs",
    "preview:public": "node tools/preview-public.mjs",
    "deploy:pages": "node tools/deploy-pages.mjs",
    "verify": "node --check app.js && node smoke.mjs",
    "verify:browser-chat": "node tools/browser-chat-proof.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.8",
    "dompurify": "$dompurify"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@toast-ui/editor": "^3.2.2",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.12",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "marked": "^18.0.6",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.1.200",
    "sortablejs": "^1.15.7",
    "tesseract.js": "^7.0.0",
    "vosk-browser": "^0.0.8"
  }
}
